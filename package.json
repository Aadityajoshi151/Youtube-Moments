{
  "name": "youtube-moments",
  "version": "1.0.0",
  "private": true,
  "description": "Save exact moments (timestamps) from YouTube videos and revisit them later.",
  "scripts": {
    "lint": "web-ext lint --warnings-as-errors",
    "build": "web-ext build --overwrite-dest",
    "dev": "web-ext run"
  },
  "webExt": {
    "ignoreFiles": [
      "screenshots/**"
    ]
  },
  "devDependencies": {
    "web-ext": "^10.6.0"
  }
}
